                <Option type="QString" value="statut" name="name"/>
                <Option type="int" value="0" name="precision"/>
                <Option type="int" value="10" name="type"/>
              </Option>
              <Option type="Map">
                <Option type="QString" value="coalesce(&quot;lampe_valeur_cible&quot;, 'XX')" name="expression"/>
                <Option type="int" value="0" name="length"/>
                <Option type="QString" value="typeSource" name="name"/>
